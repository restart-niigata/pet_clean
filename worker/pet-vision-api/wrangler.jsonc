{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pet-talk-vision-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "ratelimits": [
    {
      "name": "VISION_RATE_LIMITER",
      "namespace_id": "8252026",
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  // 試験用。`wrangler deploy --env preview` で pet-talk-vision-api-preview として公開し、本番Workerには影響させない。
  "env": {
    "preview": {
      "ai": {
        "binding": "AI",
        "remote": true
      },
      "ratelimits": [
        {
          "name": "VISION_RATE_LIMITER",
          "namespace_id": "8252027",
          "simple": {
            "limit": 12,
            "period": 60
          }
        }
      ]
    }
  }
}
